{
  "manifest_version": 2,
  "name": "Veyra presence compatibility",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "presence@veyra.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fullscreen-main.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true,
      "js": [
        "content.js"
      ]
    }
  ]
}
